      "collections": [
        {
          "id": 38,
          "name": "红陶兽形壶",
          "summary": "外观憨憨的兽型壶 装了满肚子的水",
          "description": "通高21.8、通长22.3、体宽14.5、足高7.9-8.4厘米\\n1959年 山东泰安大汶口遗址出土\\n酒器。夹砂红陶，通体磨光，圆面耸耳，遍施红色陶衣，光润亮泽。拱鼻，张口，鼓腹，四足，短尾上翘，耳穿小孔，背装弧形提手，尾根部一筒形注水口，可受水，嘴可出水，体肥壮，腹部鼓起加大了容积，四足立起便于加热，造型生动美观，近似猪或狗形。\\n全器构思巧妙，即是使用器，又不失艺术情趣，准确的把握了动物各部位的比例结构和体形特征，表现出大汶口先民们高超的制陶水平。",
          "museum": "山东博物馆",
          "resource_key": "collection_1011_png",
          "image": {
            "path": "media/resource-catalog/images/968100709d2a54916cc4c5c2ebaaf1008ec7194e63b30352d71fcc2ccb8fea18.png",
            "width": 250,
